<mw12F schema="1" type="limiter" name="Loud Squash" author="mwAudio" tags="Heavy,Glue" description="Heavy squash into a soft clipper. Every note the same loudness.">
  <params>
    <p id="lim_on" v="1"/>
    <p id="lim_knee" v="80"/>
    <p id="lim_ratio" v="20"/>
    <p id="lim_attack" v="1"/>
    <p id="lim_release" v="90"/>
    <p id="lim_threshold" v="-14"/>
    <p id="lim_gain" v="2.5"/>
    <p id="lim_soft_clip" v="1"/>
  </params>
</mw12F>
