<mw12F schema="1" type="limiter" name="Gentle Leveller" author="mwAudio" tags="Glue,Subtle" description="Slow, low-ratio levelling for long lines.">
  <params>
    <p id="lim_on" v="1"/>
    <p id="lim_knee" v="100"/>
    <p id="lim_ratio" v="2"/>
    <p id="lim_attack" v="20"/>
    <p id="lim_release" v="300"/>
    <p id="lim_threshold" v="-18"/>
    <p id="lim_gain" v="2.9"/>
    <p id="lim_soft_clip" v="0"/>
  </params>
</mw12F>
