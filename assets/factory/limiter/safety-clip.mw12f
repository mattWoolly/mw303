<mw12F schema="1" type="limiter" name="Safety Clip" author="mwAudio" tags="Safety" description="Catches stray peaks and soft clips the rest. Leave it on.">
  <params>
    <p id="lim_on" v="1"/>
    <p id="lim_knee" v="100"/>
    <p id="lim_ratio" v="40"/>
    <p id="lim_attack" v="0.5"/>
    <p id="lim_release" v="80"/>
    <p id="lim_threshold" v="-1.5"/>
    <p id="lim_gain" v="0"/>
    <p id="lim_soft_clip" v="1"/>
  </params>
</mw12F>
