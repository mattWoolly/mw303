    <p id="dist_on" v="1"/>
    <p id="dist_model" v="24"/>
    <p id="dist_dynamics" v="0"/>
    <p id="dist_dyn_post" v="0"/>
    <p id="dist_drive" v="60"/>
    <p id="dist_color" v="-15"/>
    <p id="dist_clipper" v="5"/>
    <p id="dist_pre_min" v="36"/>
    <p id="dist_pre_max" v="80"/>
    <p id="dist_knee" v="100"/>
    <p id="dist_bias" v="40"/>
    <p id="dist_low_keep" v="100"/>
    <p id="dist_pre_hp" v="0"/>
    <p id="dist_pre_eq_on" v="1"/>
    <p id="dist_pre_eq_gain" v="4"/>
    <p id="dist_pre_eq_freq" v="250"/>
    <p id="dist_pre_eq_width" v="2.5"/>
    <p id="dist_tilt_on" v="0"/>
    <p id="dist_tilt_amt" v="0"/>
    <p id="dist_tilt_freq" v="1000"/>
    <p id="dist_color_freq" v="1500"/>
    <p id="dist_color_reso" v="35"/>
    <p id="dist_color_range" v="100"/>
    <p id="dist_post_hp" v="0"/>
    <p id="dist_volume" v="1"/>
  </params>
</mw12F>
