<mw12F schema="1" type="eq" name="Squelch Focus" author="mwAudio" tags="Boost" description="A broad lift where the filter sweeps live, with the sub trimmed.">
  <params>
    <p id="eq_on" v="1"/>
    <p id="eq_low_gain" v="-4"/>
    <p id="eq_low_freq" v="45"/>
    <p id="eq_low_width" v="2"/>
    <p id="eq_lomid_gain" v="3"/>
    <p id="eq_lomid_freq" v="900"/>
    <p id="eq_lomid_width" v="2"/>
    <p id="eq_himid_gain" v="0"/>
    <p id="eq_himid_freq" v="3500"/>
    <p id="eq_himid_width" v="2"/>
    <p id="eq_high_gain" v="0"/>
    <p id="eq_high_freq" v="10000"/>
    <p id="eq_high_width" v="2"/>
  </params>
</mw12F>
