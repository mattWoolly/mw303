<mw12F schema="1" type="limiter" name="Glue" author="mwAudio" tags="Glue,Subtle" description="Gentle compression that evens out accents a little.">
  <params>
    <p id="lim_on" v="1"/>
    <p id="lim_knee" v="100"/>
    <p id="lim_ratio" v="3"/>
    <p id="lim_attack" v="10"/>
    <p id="lim_release" v="150"/>
    <p id="lim_threshold" v="-12"/>
    <p id="lim_gain" v="1"/>
    <p id="lim_soft_clip" v="0"/>
  </params>
</mw12F>
