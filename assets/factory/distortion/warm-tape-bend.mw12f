<mw12F schema="1" type="distortion" name="Warm Tape Bend" author="mwAudio" tags="Subtle,Custom Voicing" description="A custom voicing that leans on the console stage with a little bias and a low lift. Tape-like.">
  <params>
    <p id="dist_on" v="1"/>
    <p id="dist_model" v="0"/>
    <p id="dist_dynamics" v="0"/>
    <p id="dist_dyn_post" v="0"/>
    <p id="dist_drive" v="55"/>
    <p id="dist_color" v="0"/>
    <p id="dist_clipper" v="6"/>
    <p id="dist_pre_min" v="0"/>
    <p id="dist_pre_max" v="45"/>
    <p id="dist_knee" v="100"/>
    <p id="dist_bias" v="12"/>
    <p id="dist_low_keep" v="0"/>
    <p id="dist_pre_hp" v="0"/>
    <p id="dist_pre_eq_on" v="1"/>
    <p id="dist_pre_eq_gain" v="3"/>
    <p id="dist_pre_eq_freq" v="120"/>
    <p id="dist_pre_eq_width" v="2"/>
    <p id="dist_tilt_on" v="0"/>
    <p id="dist_tilt_amt" v="0"/>
    <p id="dist_tilt_freq" v="1000"/>
    <p id="dist_color_freq" v="4500"/>
    <p id="dist_color_reso" v="10"/>
    <p id="dist_color_range" v="100"/>
    <p id="dist_post_hp" v="0"/>
    <p id="dist_volume" v="-1"/>
  </params>
</mw12F>
