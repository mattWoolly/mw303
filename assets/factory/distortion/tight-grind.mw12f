<mw12F schema="1" type="distortion" name="Tight Grind" author="mwAudio" tags="Heavy,Glue" description="Hard clip with the low end trimmed before it, glued by the compressor after.">
  <params>
    <p id="dist_on" v="1"/>
    <p id="dist_model" v="9"/>
    <p id="dist_dynamics" v="30"/>
    <p id="dist_dyn_post" v="1"/>
    <p id="dist_drive" v="60"/>
    <p id="dist_color" v="0"/>
    <p id="dist_clipper" v="1"/>
    <p id="dist_pre_min" v="5"/>
    <p id="dist_pre_max" v="72"/>
    <p id="dist_knee" v="50"/>
    <p id="dist_bias" v="0"/>
    <p id="dist_low_keep" v="0"/>
    <p id="dist_pre_hp" v="100"/>
    <p id="dist_pre_eq_on" v="1"/>
    <p id="dist_pre_eq_gain" v="-5"/>
    <p id="dist_pre_eq_freq" v="550"/>
    <p id="dist_pre_eq_width" v="1.5"/>
    <p id="dist_tilt_on" v="1"/>
    <p id="dist_tilt_amt" v="7.5"/>
    <p id="dist_tilt_freq" v="290"/>
    <p id="dist_color_freq" v="2600"/>
    <p id="dist_color_reso" v="20"/>
    <p id="dist_color_range" v="100"/>
    <p id="dist_post_hp" v="25"/>
    <p id="dist_volume" v="3"/>
  </params>
</mw12F>
