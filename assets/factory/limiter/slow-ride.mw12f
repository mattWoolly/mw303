<mw12F schema="1" type="limiter" name="Slow Ride" author="mwAudio" tags="Glue,Pump" description="Lets the attack through, then holds the level down.">
  <params>
    <p id="lim_on" v="1"/>
    <p id="lim_knee" v="100"/>
    <p id="lim_ratio" v="6"/>
    <p id="lim_attack" v="30"/>
    <p id="lim_release" v="500"/>
    <p id="lim_threshold" v="-10"/>
    <p id="lim_gain" v="1"/>
    <p id="lim_soft_clip" v="0"/>
  </params>
</mw12F>
