<mw12F schema="1" type="distortion" name="Split Band Crunch" author="mwAudio" tags="Heavy,Clean Low,Custom Voicing" description="A custom voicing: hard clip on everything above 160 Hz, a tilt into the clipper and a clean sub underneath.">
  <params>
    <p id="dist_on" v="1"/>
    <p id="dist_model" v="0"/>
    <p id="dist_dynamics" v="0"/>
    <p id="dist_dyn_post" v="0"/>
    <p id="dist_drive" v="65"/>
    <p id="dist_color" v="0"/>
    <p id="dist_clipper" v="1"/>
    <p id="dist_pre_min" v="0"/>
    <p id="dist_pre_max" v="75"/>
    <p id="dist_knee" v="100"/>
    <p id="dist_bias" v="0"/>
    <p id="dist_low_keep" v="160"/>
    <p id="dist_pre_hp" v="60"/>
    <p id="dist_pre_eq_on" v="0"/>
    <p id="dist_pre_eq_gain" v="0"/>
    <p id="dist_pre_eq_freq" v="200"/>
    <p id="dist_pre_eq_width" v="1.5"/>
    <p id="dist_tilt_on" v="1"/>
    <p id="dist_tilt_amt" v="6"/>
    <p id="dist_tilt_freq" v="900"/>
    <p id="dist_color_freq" v="3000"/>
    <p id="dist_color_reso" v="30"/>
    <p id="dist_color_range" v="100"/>
    <p id="dist_post_hp" v="30"/>
    <p id="dist_volume" v="3.7"/>
  </params>
</mw12F>
