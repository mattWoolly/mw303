<mw12F schema="1" type="limiter" name="Hard Wall" author="mwAudio" tags="Heavy,Safety" description="Nothing gets past. Loud and flat.">
  <params>
    <p id="lim_on" v="1"/>
    <p id="lim_knee" v="10"/>
    <p id="lim_ratio" v="40"/>
    <p id="lim_attack" v="0.1"/>
    <p id="lim_release" v="50"/>
    <p id="lim_threshold" v="-6"/>
    <p id="lim_gain" v="1"/>
    <p id="lim_soft_clip" v="1"/>
  </params>
</mw12F>
