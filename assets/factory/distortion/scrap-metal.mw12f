<mw12F schema="1" type="distortion" name="Scrap Metal" author="mwAudio" tags="Heavy,Filtered" description="Everything at once: hard clip, high gain, a resonant colour filter. Use with care.">
  <params>
    <p id="dist_on" v="1"/>
    <p id="dist_model" v="31"/>
    <p id="dist_dynamics" v="0"/>
    <p id="dist_dyn_post" v="0"/>
    <p id="dist_drive" v="75"/>
    <p id="dist_color" v="15"/>
    <p id="dist_clipper" v="1"/>
    <p id="dist_pre_min" v="60"/>
    <p id="dist_pre_max" v="100"/>
    <p id="dist_knee" v="0"/>
    <p id="dist_bias" v="10"/>
    <p id="dist_low_keep" v="0"/>
    <p id="dist_pre_hp" v="50"/>
    <p id="dist_pre_eq_on" v="1"/>
    <p id="dist_pre_eq_gain" v="8"/>
    <p id="dist_pre_eq_freq" v="900"/>
    <p id="dist_pre_eq_width" v="2"/>
    <p id="dist_tilt_on" v="1"/>
    <p id="dist_tilt_amt" v="6"/>
    <p id="dist_tilt_freq" v="700"/>
    <p id="dist_color_freq" v="3000"/>
    <p id="dist_color_reso" v="55"/>
    <p id="dist_color_range" v="100"/>
    <p id="dist_post_hp" v="40"/>
    <p id="dist_volume" v="0.4"/>
  </params>
</mw12F>
