<mw12F schema="1" type="limiter" name="Peak Shave" author="mwAudio" tags="Safety,Subtle" description="Fast and transparent, only on the highest peaks.">
  <params>
    <p id="lim_on" v="1"/>
    <p id="lim_knee" v="60"/>
    <p id="lim_ratio" v="20"/>
    <p id="lim_attack" v="0.3"/>
    <p id="lim_release" v="40"/>
    <p id="lim_threshold" v="-3"/>
    <p id="lim_gain" v="0.1"/>
    <p id="lim_soft_clip" v="0"/>
  </params>
</mw12F>
