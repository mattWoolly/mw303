<mw12F schema="1" type="limiter" name="Pump" author="mwAudio" tags="Pump,Heavy" description="Slow release that breathes with the pattern.">
  <params>
    <p id="lim_on" v="1"/>
    <p id="lim_knee" v="50"/>
    <p id="lim_ratio" v="12"/>
    <p id="lim_attack" v="8"/>
    <p id="lim_release" v="220"/>
    <p id="lim_threshold" v="-16"/>
    <p id="lim_gain" v="4.3"/>
    <p id="lim_soft_clip" v="0"/>
  </params>
</mw12F>
