    <p id="cal_tm5" v="1"/>
    <p id="cal_pw" v="0"/>
    <p id="cal_vca_clicks" v="1"/>
    <p id="cal_vca_noise" v="0"/>
    <p id="cal_rb" v="20"/>
    <p id="cal_kmax" v="18.7"/>
    <p id="cal_cv_scale" v="0.88"/>
    <p id="cal_gate_delay" v="5.4"/>
    <p id="cal_drift" v="10"/>
    <p id="cal_cpu_jitter" v="0"/>
  </params>
</mw12F>
