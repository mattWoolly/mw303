<mw12F schema="1" type="eq" name="Nasal Cut" author="mwAudio" tags="Cut" description="Tames the honk of a high-resonance square.">
  <params>
    <p id="eq_on" v="1"/>
    <p id="eq_low_gain" v="0"/>
    <p id="eq_low_freq" v="100"/>
    <p id="eq_low_width" v="2"/>
    <p id="eq_lomid_gain" v="0"/>
    <p id="eq_lomid_freq" v="550"/>
    <p id="eq_lomid_width" v="1.5"/>
    <p id="eq_himid_gain" v="-5"/>
    <p id="eq_himid_freq" v="1400"/>
    <p id="eq_himid_width" v="1"/>
    <p id="eq_high_gain" v="0"/>
    <p id="eq_high_freq" v="10000"/>
    <p id="eq_high_width" v="2"/>
  </params>
</mw12F>
