<mw12F schema="1" type="eq" name="Low Trim" author="mwAudio" tags="Cut" description="Clears the rumble below the fundamental so the kick has room.">
  <params>
    <p id="eq_on" v="1"/>
    <p id="eq_low_gain" v="-9"/>
    <p id="eq_low_freq" v="30"/>
    <p id="eq_low_width" v="1.5"/>
    <p id="eq_lomid_gain" v="0"/>
    <p id="eq_lomid_freq" v="550"/>
    <p id="eq_lomid_width" v="1.5"/>
    <p id="eq_himid_gain" v="0"/>
    <p id="eq_himid_freq" v="3500"/>
    <p id="eq_himid_width" v="2"/>
    <p id="eq_high_gain" v="0"/>
    <p id="eq_high_freq" v="10000"/>
    <p id="eq_high_width" v="2"/>
  </params>
</mw12F>
