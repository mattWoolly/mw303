<mw12F schema="1" type="limiter" name="Punch Keeper" author="mwAudio" tags="Glue" description="Keeps the snap of each note while taming the body.">
  <params>
    <p id="lim_on" v="1"/>
    <p id="lim_knee" v="70"/>
    <p id="lim_ratio" v="4"/>
    <p id="lim_attack" v="15"/>
    <p id="lim_release" v="100"/>
    <p id="lim_threshold" v="-9"/>
    <p id="lim_gain" v="0.5"/>
    <p id="lim_soft_clip" v="1"/>
  </params>
</mw12F>
