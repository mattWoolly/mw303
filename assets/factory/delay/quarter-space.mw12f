<mw12F schema="1" type="delay" name="Quarter Space" author="mwAudio" tags="Long,Tempo Sync,Filtered" description="Quarter and half note repeats, darkening as they go.">
  <params>
    <p id="delay_on" v="1"/>
    <p id="delay_sync" v="1"/>
    <p id="delay_time" v="0.2"/>
    <p id="delay_l_num" v="1"/>
    <p id="delay_l_den" v="4"/>
    <p id="delay_l_mod" v="0"/>
    <p id="delay_r_num" v="1"/>
    <p id="delay_r_den" v="2"/>
    <p id="delay_r_mod" v="0"/>
    <p id="delay_feedback" v="45"/>
    <p id="delay_filt_type" v="1"/>
    <p id="delay_filt_cutoff" v="2500"/>
    <p id="delay_filt_reso" v="0"/>
    <p id="delay_spread" v="50"/>
    <p id="delay_mix" v="20"/>
  </params>
</mw12F>
