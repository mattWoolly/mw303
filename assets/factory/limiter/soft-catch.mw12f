<mw12F schema="1" type="limiter" name="Soft Catch" author="mwAudio" tags="Safety,Subtle" description="Rounds off the accent peaks only.">
  <params>
    <p id="lim_on" v="1"/>
    <p id="lim_knee" v="100"/>
    <p id="lim_ratio" v="8"/>
    <p id="lim_attack" v="2"/>
    <p id="lim_release" v="120"/>
    <p id="lim_threshold" v="-4"/>
    <p id="lim_gain" v="0"/>
    <p id="lim_soft_clip" v="1"/>
  </params>
</mw12F>
